APP_NAME="Nadabo Global Data"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG
APP_TIMEZONE=Africa/Lagos

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database: MySQL 8 / MariaDB 10.6+. Fill these in your local .env only.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# cPanel-friendly drivers (no Redis required)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Admin area uses its own session cookie (path /admin) and table
ADMIN_SESSION_COOKIE=nadabo_admin_session
ADMIN_SESSION_TABLE=admin_sessions

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Customer email verification (true/false). Needs working mail settings when true.
NADABO_REQUIRE_EMAIL_VERIFICATION=false

# API token lifetime in minutes (e.g. 43200 = 30 days). Empty or 0 = tokens do not expire.
SANCTUM_TOKEN_EXPIRATION=
